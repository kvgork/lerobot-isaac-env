#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    defaultPrim = "so101_new_calib"
    doc = """Generated from Composed Stage of root layer /tmp/tmpyst9pnv6/so101_new_calib.usdc


Generated from Composed Stage of root layer /mnt/data/workspaces/lerobot-isaac-training/src/lerobot-isaac-env/assets/usd/usdex/so101_new_calib.usdc


Generated from Composed Stage of root layer /mnt/data/workspaces/lerobot-isaac-training/src/lerobot-isaac-env/assets/usd/temp/so101_new_calib.usd


Generated from Composed Stage of root layer /mnt/data/workspaces/lerobot-isaac-training/src/lerobot-isaac-env/assets/usd/so101_new_calib/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "so101_new_calib" (
    prepend apiSchemas = ["IsaacRobotAPI", "IsaacLinkAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "shoulder_pan" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder_lift" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "elbow_flex" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_flex" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist_roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_frame_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "shoulder_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "upper_arm_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "lower_arm_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "wrist_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "gripper_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "moving_jaw_so101_v1_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }

                                over "gripper_frame_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

